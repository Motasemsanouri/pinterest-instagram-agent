# ─── Anthropic API (required for Phase 2+ LLM agents) ───────────────────────
ANTHROPIC_API_KEY=""
VISION_MODEL=claude-haiku-4-5-20251001

# ─── Pinterest credentials (optional — improves scraping quality) ─────────────
PINTEREST_EMAIL=
PINTEREST_PASSWORD=

# ─── Scraping settings ────────────────────────────────────────────────────────
MAX_PINS_PER_QUERY=50
HEADLESS_BROWSER=false
BROWSER_TIMEOUT=30000
SCROLL_DELAY_MIN=1.0
SCROLL_DELAY_MAX=3.0

# ─── Retry settings ───────────────────────────────────────────────────────────
MAX_RETRIES=3
RETRY_DELAY=2.0

# ─── Logging settings ─────────────────────────────────────────────────────────
LOG_LEVEL=INFO
# Options: json, console
LOG_FORMAT=json
LOG_FILE=

# ─── Output settings ──────────────────────────────────────────────────────────
OUTPUT_DIR=data
SAVE_RESULTS=true
